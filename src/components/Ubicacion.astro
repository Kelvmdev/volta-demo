---
import site from '../data/site.json';
const wa = site.contacto.whatsappUrl;
const { direccionFull, horario, whatsappDisplay, lat, lon } = site.contacto;
const head = site.ubicacionHead;
const mapEmbed = `https://www.google.com/maps?q=${lat},${lon}&z=17&hl=es&output=embed`;
const mapLink = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}`;
---
<section id="ubicacion" class="bg-negro2 py-20 md:py-28">
  <div class="mx-auto grid max-w-[1240px] gap-10 px-6 md:grid-cols-2 md:gap-14">
    <div class="reveal">
      <p class="mb-4 flex items-center gap-3 text-[0.78rem] font-bold uppercase tracking-[.22em] text-tenue">
        <span class="v-tick v-line"></span>{head.eyebrow}
      </p>
      <h2 class="font-display text-[clamp(2rem,4.5vw,3.4rem)] font-semibold uppercase leading-[1.02]" set:html={head.h2}></h2>

      <div class="mt-8 space-y-5 text-crema/90">
        <div class="flex gap-4">
          <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-md bg-ambar/12 text-ambar" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <div><p class="font-bold text-crema">Dirección</p><p class="text-tenue">{direccionFull}</p></div>
        </div>
        <div class="flex gap-4">
          <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-md bg-ambar/12 text-ambar" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          </span>
          <div><p class="font-bold text-crema">Horario</p><p class="text-tenue">{horario}</p></div>
        </div>
        <div class="flex gap-4">
          <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-md bg-ambar/12 text-ambar" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .8 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.4 1.9.7 2.9.8a2 2 0 0 1 1.7 2Z"/></svg>
          </span>
          <div><p class="font-bold text-crema">WhatsApp</p><p class="text-tenue">{whatsappDisplay}</p></div>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={wa} target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 rounded-full bg-ambar px-6 py-3.5 font-bold uppercase tracking-[.03em] text-negro-hondo transition active:scale-95 hover:-translate-y-0.5 hover:bg-ambar2">Escríbenos por WhatsApp</a>
        <a href={mapLink} target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 rounded-full border-[1.5px] border-borde px-6 py-3.5 font-bold uppercase tracking-[.03em] text-crema transition active:scale-95 hover:border-ambar hover:text-ambar2">Cómo llegar</a>
      </div>
    </div>

    <!-- mapa con anti-hijack: overlay que se quita al hacer clic -->
    <div class="reveal group relative min-h-80 overflow-hidden rounded-2xl border border-white/10 shadow-2xl">
      <iframe
        title="Ubicación de VOLTA en El Poblado, Medellín"
        src={mapEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="absolute inset-0 h-full w-full border-0"
      ></iframe>
      <button
        type="button"
        class="map-overlay absolute inset-0 flex items-center justify-center bg-negro2/40 text-sm font-bold text-crema backdrop-blur-[1px] transition hover:bg-negro2/20"
        aria-label="Activar el mapa"
      >
        <span class="rounded-full bg-negro2/80 px-4 py-2">Toca para interactuar con el mapa</span>
      </button>
    </div>
  </div>
</section>

<script>
  // anti-hijack: el mapa no captura el scroll hasta que el usuario hace clic
  document.querySelectorAll<HTMLButtonElement>('.map-overlay').forEach((ov) =>
    ov.addEventListener('click', () => {
      ov.style.display = 'none';
      ov.parentElement?.querySelector('iframe')?.focus();
    }),
  );
</script>
