---
import site from '../data/site.json';
const wa = site.contacto.whatsappUrl;
const h = site.hero;
---

<header id="inicio" class="relative flex min-h-[100svh] items-end overflow-hidden isolate">
  <!-- fondo con zoom lento -->
  <div class="hero-bg absolute inset-0 -z-20"></div>
  <!-- degradados para legibilidad -->
  <div class="hero-shade absolute inset-0 -z-10"></div>

  <div class="mx-auto w-full max-w-[1240px] px-6 pb-14 pt-32 sm:pb-20">
    <p class="rise d1 mb-5 flex items-center gap-3 text-[0.82rem] font-bold uppercase tracking-[.22em] text-ambar">
      <span class="v-tick v-line"></span>{h.eyebrow}
    </p>

    <h1 class="rise d2 font-display font-bold uppercase leading-[.9] tracking-[.005em] text-[clamp(3.2rem,11vw,8rem)]">
      <span class="block">{h.titulo1}</span>
      <span class="block">{h.titulo2} <span class="text-ambar">{h.tituloAcento}</span></span>
    </h1>

    <p class="rise d3 mt-6 max-w-[34rem] text-[clamp(1.02rem,1.6vw,1.28rem)] leading-relaxed text-crema/90">
      {h.parrafo}
    </p>

    <div class="rise d4 mt-8 flex flex-wrap gap-4">
      <a href={wa} target="_blank" rel="noopener"
        class="inline-flex items-center rounded-full bg-ambar px-7 py-4 text-[1.05rem] font-bold uppercase tracking-[.03em] text-negro-hondo transition active:scale-95 hover:-translate-y-0.5 hover:bg-ambar2 hover:shadow-[0_14px_34px_-10px_rgba(38,230,240,.7)]"
        >{h.ctaPrimario}</a
      >
      <a href="#planes"
        class="inline-flex items-center rounded-full border-[1.5px] border-white/45 px-7 py-4 text-[1.05rem] font-bold uppercase tracking-[.03em] text-crema transition active:scale-95 hover:-translate-y-0.5 hover:border-ambar hover:text-ambar"
        >{h.ctaSecundario}</a
      >
    </div>

    <!-- prueba social -->
    <dl class="rise d5 mt-11 flex flex-wrap gap-x-10 gap-y-5 border-t border-white/10 pt-6">
      {h.stats.map(([n, l]) => (
        <div>
          <dt class="font-display text-[1.9rem] font-bold leading-none text-crema">{n}</dt>
          <dd class="mt-1 font-slab text-[0.78rem] uppercase tracking-[.06em] text-tenue">{l}</dd>
        </div>
      ))}
    </dl>
  </div>
</header>
