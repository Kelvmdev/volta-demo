---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Página no encontrada — VOLTA"
  description="Esta página no existe. Vuelve al inicio para ver las disciplinas, los planes y cómo llegar a VOLTA."
  jsonLd={false}
  preloadHero={false}
  noindex={true}
>
  <Nav />
  <main id="contenido" tabindex="-1" class="flex min-h-svh flex-col items-center justify-center px-6 pt-28 text-center">
    <span class="font-display text-4xl font-black uppercase leading-none tracking-[.16em] text-crema">VOLT<span class="text-ambar">A</span></span>
    <p class="mt-8 font-display text-[clamp(3rem,12vw,6rem)] font-bold leading-none text-ambar">404</p>
    <h1 class="mt-2 font-display text-2xl font-semibold uppercase">Esta página no existe</h1>
    <p class="mt-3 max-w-md text-crema/80">No encontramos lo que buscabas, pero VOLTA sigue con la energía encendida.</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2.5 rounded-full bg-ambar px-7 py-4 font-slab font-bold uppercase tracking-[.03em] text-negro-hondo transition active:scale-95 hover:-translate-y-0.5 hover:bg-ambar2"
      ><span aria-hidden="true">⚡</span> Volver al inicio</a
    >
  </main>
  <Footer />
</Layout>
