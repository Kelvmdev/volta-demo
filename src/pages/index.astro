---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import StatsBand from '../components/StatsBand.astro';
import Disciplinas from '../components/Disciplinas.astro';
import Sobre from '../components/Sobre.astro';
import Planes from '../components/Planes.astro';
import Horario from '../components/Horario.astro';
import Resenas from '../components/Resenas.astro';
import Ambiente from '../components/Ambiente.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Faq from '../components/Faq.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main id="contenido" tabindex="-1">
    <Hero />
    <StatsBand />
    <Disciplinas />
    <Sobre />
    <Planes />
    <Horario />
    <Resenas />
    <Ambiente />
    <Ubicacion />
    <Faq />
    <CTA />
  </main>
  <Footer />
</Layout>
